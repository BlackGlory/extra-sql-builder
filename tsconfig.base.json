{
  "compilerOptions": {
    "target": "ES2020"
  , "module": "NodeNext"
  , "strict": true
  , "esModuleInterop": true
  , "noUnusedLocals": false
  , "noUnusedParameters": false
  , "rootDir": "src"
  , "paths": {
      "@values/*": ["./src/values/*"]
    , "@fragments/*": ["./src/fragments/*"]
    , "@src/*": ["./src/*"]
    , "@test/*": ["./__tests__/*"]
    }
  }
}
